---
// 根布局 — Astro 替代 Next.js 的 app/layout.tsx
import '@/styles/globals.css';
import '@/styles/rtl.css';
import Navbar from '@/components/Navbar';
import ThemeHeader from '@/components/theme/ThemeHeader';
import ThemeFooter from '@/components/theme/ThemeFooter';
import MobileBottomNav from '@/components/MobileBottomNav';
import {GlobalShortcuts} from '@/components/GlobalShortcuts';
import MobileGestures from '@/components/MobileGestures';
import OfflineBanner from '@/components/OfflineBanner';

export interface Props {
  title?: string;
  description?: string;
  dir?: 'ltr' | 'rtl';
  lang?: string;
}

const {title = 'FastBlog', description = 'A modern blog platform', dir = 'ltr', lang = 'zh-CN'} = Astro.props;
---

<html lang={lang} dir={dir} suppressHydrationWarning>
  <head>
    <meta charset="utf-8" />
      <!-- 响应式Viewport: 支持iOS viewport-fit=cover, 适配安全区域 -->
      <meta name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content"/>
      <!-- 响应式: 禁止微信/QQ内嵌浏览器双击缩放 -->
      <meta name="maximum-scale" content="5.0"/>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#3b82f6" />

      <!-- Fonts: Inter (matching BaseLayout/admin), Noto Serif SC for editorial headlines, system font fallback for CJK -->
      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
      <link rel="preload" as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"/>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
            media="print" onload="this.media='all'"/>
      <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&display=swap"
            media="print" onload="this.media='all'"/>
      <noscript>
          <link rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif+SC:wght@500;600;700&display=swap"/>
      </noscript>
    <slot name="head" />

    <!-- Theme sync: apply dark class before paint to prevent flash -->
    <script is:inline>
      (function() {
        var key = 'fastblog-theme';
        var cls = 'dark';
        var root = document.documentElement;
        try {
          var stored = localStorage.getItem(key);
          if (stored === 'dark') {
            root.classList.add(cls);
          } else if (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            root.classList.add(cls);
          }
        } catch(e) {}
      })();
    </script>

      <!-- Active theme CSS + 契约应用：采用 requestIdleCallback 非阻塞加载 -->
      <script defer>
      (function() {
        var root = document.documentElement;
          var applyTheme = function () {
              // 1) 注入激活主题 CSS (高优先级)
              if (!document.getElementById('active-theme-css')) {
                  fetch('/api/v2/themes/active/css').then(function (r) {
                      return r.json();
                  }).then(function (data) {
                      if (data && data.data && data.data.css && !document.getElementById('active-theme-css')) {
                          var style = document.createElement('style');
                          style.id = 'active-theme-css';
                          style.textContent = data.data.css;
                          document.head.appendChild(style);
                      }
                  }).catch(function () {
                  });
              }
              // 2) 应用主题契约（低优先级 - 不影响首次渲染）
              if (typeof requestIdleCallback !== 'undefined') {
                  requestIdleCallback(function () {
                      fetch('/api/v2/themes/active/config').then(function (r) {
                          return r.json();
                      }).then(applyConfig);
                  }, {timeout: 1000});
              } else {
                  fetch('/api/v2/themes/active/config').then(function (r) {
                      return r.json();
                  }).then(applyConfig);
              }
          };

          function applyConfig(data) {
          var d = data && data.data;
          if (!d) return;
          function setVar(n, v) { if (v !== undefined && v !== null && v !== '') { root.style.setProperty(n, String(v)); } }
          var s = (d.contract && d.contract.settings) || d.config || {};
          if (s.colors) {
            setVar('--color-primary', s.colors.primary);
            setVar('--color-primary-hover', s.colors.primary);
            setVar('--color-accent', s.colors.accent);
            setVar('--color-surface', s.colors.background);
            setVar('--color-surface-elevated', s.colors.muted);
            setVar('--color-text', s.colors.foreground);
            setVar('--color-text-secondary', s.colors.secondary);
            setVar('--color-text-muted', s.colors.muted);
            setVar('--color-muted', s.colors.muted);
            setVar('--color-border', s.colors.border);
          }
          if (s.typography && s.typography.fontFamily) { setVar('--font-sans', s.typography.fontFamily); }
          if (s.components && s.components.borderRadius) {
            ['--radius-sm','--radius-md','--radius-lg','--radius-xl','--radius-2xl'].forEach(function(n){ setVar(n, s.components.borderRadius); });
          }
          var layout = (d.contract && d.contract.layout) || {};
          if (layout.sidebarPosition) { root.dataset.sidebar = layout.sidebarPosition; }
          if (layout.contentWidth) { root.dataset.contentWidth = layout.contentWidth; }
          if (typeof layout.showHeader === 'boolean') { root.dataset.showHeader = String(layout.showHeader); }
          if (typeof layout.showFooter === 'boolean') { root.dataset.showFooter = String(layout.showFooter); }
          var slots = (d.contract && d.contract.componentSlots) || {};
          if (slots.header) { root.dataset.themeHeader = slots.header; }
          if (slots.articleCard) { root.dataset.themeCard = slots.articleCard; }
          if (slots.footer) { root.dataset.themeFooter = slots.footer; }
          try { window.dispatchEvent(new CustomEvent('theme:applied')); } catch (e) {}
          }

          // 等待 DOM 解析完成后应用主题
          if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', applyTheme);
          } else {
              applyTheme();
          }
      })();
    </script>

    <!-- KaTeX: LaTeX formula rendering (used by katex-render plugin) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous"/>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" crossorigin="anonymous"
            onload="document.addEventListener('astro:after-swap', function(){try{renderMathInElement(document.body,{delimiters:[{left:'\\(',right:'\\)',display:false},{left:'\\[',right:'\\]',display:true}]});}catch(e){}});renderMathInElement(document.body,{delimiters:[{left:'\\(',right:'\\)',display:false},{left:'\\[',right:'\\]',display:true}]});"></script>
  </head>
  <body class="antialiased theme-bg theme-text" suppressHydrationWarning>
  <OfflineBanner client:load/>
    <ThemeHeader client:load />
    <GlobalShortcuts client:load />
    <MobileGestures client:load />

  <main class="min-h-screen">
      <slot />
    </main>

    <ThemeFooter client:load />

  <!-- 移动端底部导航 -->
  <MobileBottomNav client:idle/>

  <slot name="scripts" />
  </body>
</html>
