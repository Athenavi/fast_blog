{
  "name": "SMS Provider",
  "slug": "sms-provider",
  "version": "1.0.0",
  "description": "短信服务提供商插件 — 支持阿里云、腾讯云、Twilio，通过插件设置切换。核心短信验证服务自动委派至此插件。",
  "author": "FastBlog Team",
  "author_url": "https://athenavi.github.io",
  "category": "integration",
  "icon": "📱",
  "license": "MIT",
  "tags": [
    "sms",
    "verification",
    "aliyun",
    "tencent",
    "twilio"
  ],
  "requires": {
    "fastblog": ">=1.0.0",
    "python": ">=3.8"
  },
  "capabilities": [
    "send:custom:sms"
  ],
  "settings_schema": {
    "provider": {
      "type": "select",
      "label": "短信服务商",
      "options": [
        {
          "value": "aliyun",
          "label": "阿里云短信"
        },
        {
          "value": "tencent",
          "label": "腾讯云短信"
        },
        {
          "value": "twilio",
          "label": "Twilio"
        }
      ],
      "default": "aliyun",
      "required": true,
      "help": "选择短信服务提供商，需在下方填写对应的凭据"
    },
    "aliyun_access_key_id": {
      "type": "text",
      "label": "阿里云 AccessKeyId",
      "required": false,
      "help": "阿里云 RAM 用户 AccessKeyId"
    },
    "aliyun_access_key_secret": {
      "type": "text",
      "label": "阿里云 AccessKeySecret",
      "required": false,
      "help": "阿里云 RAM 用户 AccessKeySecret"
    },
    "aliyun_sign_name": {
      "type": "text",
      "label": "阿里云签名名称",
      "required": false
    },
    "aliyun_template_code": {
      "type": "text",
      "label": "阿里云模板编号",
      "required": false,
      "help": "SMS_开头的模板编号，模板内容须含 ${code} 变量"
    },
    "tencent_secret_id": {
      "type": "text",
      "label": "腾讯云 SecretId",
      "required": false
    },
    "tencent_secret_key": {
      "type": "text",
      "label": "腾讯云 SecretKey",
      "required": false
    },
    "tencent_app_id": {
      "type": "text",
      "label": "腾讯云短信应用 SDKAppID",
      "required": false
    },
    "tencent_sign_name": {
      "type": "text",
      "label": "腾讯云签名内容",
      "required": false
    },
    "tencent_template_id": {
      "type": "text",
      "label": "腾讯云模板 ID",
      "required": false
    },
    "twilio_account_sid": {
      "type": "text",
      "label": "Twilio Account SID",
      "required": false
    },
    "twilio_auth_token": {
      "type": "text",
      "label": "Twilio Auth Token",
      "required": false
    },
    "twilio_from_number": {
      "type": "text",
      "label": "Twilio 发送号码",
      "required": false,
      "help": "Twilio 分配的发送号码，如 +1234567890"
    }
  }
}
