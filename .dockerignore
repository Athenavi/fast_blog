# Git
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
*$py.class
*.egg-info
dist
build
.eggs
*.egg
.venv
venv
env
.mypy_cache
.pytest_cache
htmlcov
.coverage

# Node.js
node_modules
.nuxt
.next
.output

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Logs
logs
*.log

# Environment files
# 注意：镜像会被分发/推送，任何 .env 变体都不得进入镜像层。
# 后端运行时配置由 docker-compose 的 environment 注入（见 docker-compose.yml），
# config/.env 只在本地开发时由 load_dotenv 读取。
.env
.env.*
*.env
.env.bak-*
config/.env
config/.env.*
frontend/web/.env.e2e

# Documentation (not needed in container)
docs
*.md
!README.md

# Development files
tests
.gitignore
.editorconfig
Makefile
docker-compose*.yml

# OS files
.DS_Store
Thumbs.db

# ============================================================================
# Docker-specific: Exclude directories NOT needed by the backend at runtime
# (These are either volume-mounted, separate containers, or not used)
# ============================================================================

# Frontend source (built by the frontend container from ./frontend/web)
frontend

# User data directories (volume-mounted at runtime)
media
uploads
upload_chunks
backups

# Nginx config (separate nginx container)
nginx

# Mobile app source
mobile-app

# Tools (not imported by backend)
# tools/ excluded（ffmpeg 现由镜像内的 apt 安装，不再是构建上下文的一部分）
scripts
tools

# Advanced adapter (not imported anywhere in src/)
advanced

# Generated apps (not imported, legacy Django code)
apps/generated


# Runtime generated data (not needed in image)
static_generated
plugins_data
custom-patterns

# Build/release directories
debug
release
storage

# CI/CD
pre-commit-config.yaml
.qoderignore

# Lock files (not needed for Python backend)
package-lock.json

# Test plugin system script
test_plugin_system.py

# Startup scripts (not needed inside container)
start-meilisearch.bat
start-meilisearch.sh

# Pyproject/pytest configs (not needed at runtime)
pyproject.toml
pytest.ini
