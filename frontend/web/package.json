{
  "name": "fastblog-web",
  "description": "FastBlog 前端：Nuxt 4 前台（SSR）+ 管理后台（CSR）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prescan": "node ../../scripts/scan-plugin-frontend.mjs",
    "predev": "npm run prescan",
    "prebuild": "npm run prescan",
    "dev": "nuxt dev --dotenv .env.development",
    "build": "nuxt build --dotenv .env.production",
    "build:check": "npm run prescan && nuxt typecheck && nuxt build --dotenv .env.production",
    "generate": "nuxt generate --dotenv .env.production",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "type-check": "npm run prescan && nuxt typecheck",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.9",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "element-plus": "~2.14.3",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "nprogress": "^0.2.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.6.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.0",
    "vue": "^3.5.34",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.5",
    "@types/nprogress": "^0.2.3",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.2.9"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
