# 生产环境配置
# 浏览器侧保持同源（nginx 反代 /api 与 /media），故留空；
# 服务端渲染需要绝对地址，由部署环境注入 NUXT_PUBLIC_API_BASE_URL。
NUXT_PUBLIC_API_BASE_URL=

# 浏览器侧 WebSocket 基址：生产**留空**（同源），由 nginx 转发 Upgrade
# （`nginx/nginx.conf` 的 `map $http_upgrade $connection_upgrade`）。
# 仅 dev 需要显式指定（见 .env.development）。
NUXT_PUBLIC_WS_BASE_URL=
