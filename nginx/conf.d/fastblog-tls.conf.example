# ============================================================================
# FastBlog HTTPS (443/TLS) server 块 —— 生产启用模板
# ============================================================================
# 本文件的后缀是 `.example`，**不会**被 `nginx/nginx.conf` 的
# `include /etc/nginx/conf.d/*.conf` 加载，所以原样部署时 nginx 只服务 80（HTTP）。
# 这样设计是刻意的：TLS 需要真实证书，缺证书时 nginx 会直接启动失败，
# 把未配置的 TLS 块塞进默认配置会让"开箱部署"整体起不来。
#
# 启用步骤
# --------
# 1. 准备证书，放到宿主机的 `nginx/ssl/`（compose 已把该目录挂到容器
#    `/etc/nginx/ssl:ro`）：
#
#      nginx/ssl/fullchain.pem   证书链（必须含中间证书）
#      nginx/ssl/privkey.pem     私钥
#
#    生产请用受信任 CA 签发（Let's Encrypt / 企业 CA）；自签证书只适合内网联调。
#
# 2. 把本文件重命名为 `fastblog-tls.conf`（去掉 `.example`）。
#    重命名后**必须**先确认第 1 步的两个文件都在，否则 nginx 启动失败。
#
# 3. 把站点对外地址改成 https —— 它是 Cookie 是否带 `Secure` 的唯一判定依据
#    （`src/api/v3/core/security.py::is_https`）：
#
#      SITE_URL=https://your-domain
#
#    ⚠️ 只做了第 2 步、却把 SITE_URL 留在 http:// 时，Cookie 不会带 Secure；
#       反过来 SITE_URL 填 https:// 但实际只有 HTTP，浏览器会拒绝保存 Secure
#       Cookie，表现为**登录后立刻掉线**。两者必须一致。
#
# 4. （可选，推荐）强制 HTTP 跳 HTTPS：在 `fastblog.conf` 的 80 server 块里，
#    把除 `/health` 外的 location 换成
#
#      return 301 https://$host$request_uri;
#
#    `/health` 建议保留在 80 上，避免内网探针被 301 影响。
#
# 5. 重载：
#      docker compose -f docker-compose.prod.yml exec nginx nginx -s reload
#
# 说明：限流 zone（api / login / general）在 `fastblog.conf` 的 http 级定义，
# 本文件直接引用即可，**不要**重复定义 `limit_req_zone`。
# ============================================================================

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # 协议与套件：只保留 TLS 1.2+ 与现代前向保密套件
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP stapling：证书链需含中间证书，否则此项应关闭
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    # HSTS：确认全站 HTTPS 可用后再启用；一旦下发，回退 http 会被浏览器拦 6 个月
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    # 安全响应头（与 fastblog.conf 的 80 块保持一致）
    server_tokens off;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml
        application/rss+xml
        image/svg+xml;

    client_max_body_size 60M;
    client_body_timeout 60s;
    client_header_timeout 60s;

    # 登录 / 注册的独立限流（复用 http 级 login zone）
    # 正则 location 优先级高于下方前缀 location /api/，命中后不再回落到 /api/。
    location ~ ^/api/v3/(system|mobile)/auth/(login|register) {
        limit_req zone=login burst=10 nodelay;

        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
    }

    location /api/ {
        limit_req zone=api burst=50 nodelay;

        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
    }

    location /_nuxt/ {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_cache fastblog_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        add_header X-Cache-Status $upstream_cache_status always;
        log_not_found off;
    }

    location / {
        limit_req zone=general burst=100 nodelay;

        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location /health {
        access_log off;
        proxy_pass http://backend/api/v3/health;
    }

    # /favicon.ico → 真实图标（工程只提供 SVG）
    location = /favicon.ico {
        access_log off;
        log_not_found off;
        return 302 /favicon.svg;
    }

    # /robots.txt 与 sitemap 都由后端实现
    location = /robots.txt {
        access_log off;
        log_not_found off;
        proxy_pass http://backend;
    }

    location = /sitemap.xml {
        proxy_pass http://backend;
    }
}
